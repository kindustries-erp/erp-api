FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash python3 ca-certificates curl gnupg \
  && install -d -m 0755 /etc/apt/keyrings \
  && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client-16 \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock ./
RUN npm install --global bun@1.3.5 \
  && bun install --frozen-lockfile

COPY tsconfig*.json ./
COPY src ./src
COPY .agents/skills/db-migrate/scripts/typeorm-runner.sh ./.agents/skills/db-migrate/scripts/typeorm-runner.sh
RUN chmod 0755 ./.agents/skills/db-migrate/scripts/typeorm-runner.sh

CMD ["bash", ".agents/skills/db-migrate/scripts/typeorm-runner.sh", "run", "/app/runtime.env"]

ENTRYPOINT []
