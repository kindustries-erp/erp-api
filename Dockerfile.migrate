FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash python3 postgresql-client ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock ./
RUN npm install --global bun@1.3.5 \
  && bun install --frozen-lockfile

COPY tsconfig*.json ./
COPY src ./src
COPY .agents/skills/db-migrate/scripts/typeorm-runner.sh ./.agents/skills/db-migrate/scripts/typeorm-runner.sh
RUN chmod 0755 ./.agents/skills/db-migrate/scripts/typeorm-runner.sh

CMD ["bash", ".agents/skills/db-migrate/scripts/typeorm-runner.sh", "run", "/app/runtime.env"]

ENTRYPOINT []
