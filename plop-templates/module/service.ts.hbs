import {
  Injectable,
  NotFoundException,
  ConflictException,
} from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository, SelectQueryBuilder } from 'typeorm';
import { {{pascalCase entityName}} } from './entities/{{kebabCase entityName}}.entity';
import { Create{{pascalCase entityName}}Dto } from './dto/create-{{kebabCase entityName}}.dto';
import { Update{{pascalCase entityName}}Dto } from './dto/update-{{kebabCase entityName}}.dto';
import { PaginationDto } from '../common/dto/pagination.dto';

@Injectable()
export class {{pascalCase moduleName}}Service {
  constructor(
    @InjectRepository({{pascalCase entityName}})
    private readonly repo: Repository<{{pascalCase entityName}}>,
  ) {}

  async create(dto: Create{{pascalCase entityName}}Dto): Promise<{{pascalCase entityName}}> {
    const existing = await this.repo.findOne({ where: { code: dto.code } });
    if (existing) {
      throw new ConflictException(`Mã ${dto.code} đã tồn tại trong hệ thống.`);
    }

    const entity = this.repo.create(dto);
    return this.repo.save(entity);
  }

  async findAll(query: PaginationDto) {
    const page = Math.max(1, Number(query.page) || 1);
    const pageSize = Math.max(1, Math.min(200, Number(query.pageSize) || 20));
    const skip = (page - 1) * pageSize;

    const qb = this.repo.createQueryBuilder('e');

    // 1. Keyword search
    if (query.search) {
      qb.andWhere('(e.code ILIKE :search OR e.name ILIKE :search)', {
        search: `%${query.search.trim()}%`,
      });
    }

    // 2. Column-level text search
    if (query.column_search) {
      try {
        const colSearch = typeof query.column_search === 'string'
          ? JSON.parse(query.column_search)
          : query.column_search;
        Object.entries(colSearch).forEach(([col, val]) => {
          if (val && typeof val === 'string' && val.trim()) {
            qb.andWhere(`e.${col} ILIKE :colSearch_${col}`, {
              [`colSearch_${col}`]: `%${val.trim()}%`,
            });
          }
        });
      } catch (e) {
        // ignore parse error
      }
    }

    // 3. Column-level checkbox multi-filters
    if (query.column_filters) {
      try {
        const colFilters = typeof query.column_filters === 'string'
          ? JSON.parse(query.column_filters)
          : query.column_filters;
        Object.entries(colFilters).forEach(([col, vals]) => {
          if (Array.isArray(vals) && vals.length > 0) {
            qb.andWhere(`e.${col} IN (:...colVals_${col})`, {
              [`colVals_${col}`]: vals,
            });
          }
        });
      } catch (e) {
        // ignore parse error
      }
    }

    // 4. Status filter
    if (query.status) {
      qb.andWhere('e.status = :status', { status: query.status });
    }

    // 5. Sorting
    if (query.sort) {
      const isDesc = query.sort.startsWith('-');
      const field = isDesc ? query.sort.substring(1) : query.sort;
      qb.orderBy(`e.${field}`, isDesc ? 'DESC' : 'ASC');
    } else {
      qb.orderBy('e.createdAt', 'DESC');
    }

    const [data, total] = await qb.skip(skip).take(pageSize).getManyAndCount();

    return {
      message: 'Lấy danh sách thành công',
      data,
      total,
      page,
      pageSize,
      totalPages: Math.ceil(total / pageSize),
    };
  }

  async findOne(id: string): Promise<{{pascalCase entityName}}> {
    const item = await this.repo.findOne({ where: { id } });
    if (!item) {
      throw new NotFoundException(`Không tìm thấy bản ghi với ID ${id}`);
    }
    return item;
  }

  async update(id: string, dto: Update{{pascalCase entityName}}Dto): Promise<{{pascalCase entityName}}> {
    const item = await this.findOne(id);
    if (dto.code && dto.code !== item.code) {
      const existing = await this.repo.findOne({ where: { code: dto.code } });
      if (existing) {
        throw new ConflictException(`Mã ${dto.code} đã tồn tại.`);
      }
    }
    Object.assign(item, dto);
    return this.repo.save(item);
  }

  async remove(id: string): Promise<{ success: boolean; message: string }> {
    await this.findOne(id);
    await this.repo.softDelete(id);
    return { success: true, message: 'Xóa bản ghi thành công' };
  }

  /**
   * Server-side dynamic column options for TableColumnHeaderFilter infinite scroll
   */
  async getColumnOptions(
    column: string,
    search?: string,
    page: number = 1,
    pageSize: number = 20,
    filtersStr?: string,
  ) {
    const allowedColumns = ['code', 'name', 'status'];
    if (!allowedColumns.includes(column)) {
      return { options: [], hasNextPage: false };
    }

    const qb = this.repo.createQueryBuilder('e')
      .select(`DISTINCT e.${column}`, 'value')
      .where(`e.${column} IS NOT NULL`);

    if (search && search.trim()) {
      qb.andWhere(`e.${column} ILIKE :search`, { search: `%${search.trim()}%` });
    }

    if (filtersStr) {
      try {
        const filters = JSON.parse(filtersStr);
        Object.entries(filters).forEach(([col, vals]) => {
          if (col !== column && Array.isArray(vals) && vals.length > 0) {
            qb.andWhere(`e.${col} IN (:...f_${col})`, { [`f_${col}`]: vals });
          }
        });
      } catch (e) {
        // ignore parse error
      }
    }

    const skip = (Math.max(1, page) - 1) * pageSize;
    const rawResults = await qb.offset(skip).limit(pageSize + 1).getRawMany();

    const hasNextPage = rawResults.length > pageSize;
    const sliced = rawResults.slice(0, pageSize);

    const options = sliced.map((r) => ({
      label: String(r.value || ''),
      value: String(r.value || ''),
    }));

    return { options, hasNextPage };
  }
}
