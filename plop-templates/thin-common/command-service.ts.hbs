import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { DeepPartial, Repository } from 'typeorm';
import { {{entityName}} } from '../entities/{{entityKebab}}.entity';
import { Create{{entityName}}Dto } from '../dto/create-{{entityKebab}}.dto';
import { Update{{entityName}}Dto } from '../dto/update-{{entityKebab}}.dto';

/**
 * Ghi dữ liệu: tạo, cập nhật, xóa mềm. DTO kế thừa lõi nên ghi cả cột lõi và cột riêng.
 * Việc kiểm tra tồn tại do Facade đảm nhiệm.
 */
@Injectable()
export class {{entityName}}CommandService {
  constructor(
    @InjectRepository({{entityName}})
    private readonly repo: Repository<{{entityName}}>,
  ) {}

  create(dto: Create{{entityName}}Dto): Promise<{{entityName}}> {
    // DTO lõi dùng kiểu chuỗi cho ngày; TypeORM nhận chuỗi ISO cho cột timestamptz
    const entity = this.repo.create({ ...dto, isDeleted: false } as unknown as DeepPartial<{{entityName}}>);
    return this.repo.save(entity);
  }

  update(entity: {{entityName}}, dto: Update{{entityName}}Dto): Promise<{{entityName}}> {
    Object.assign(entity, dto);
    return this.repo.save(entity);
  }

  softDelete(entity: {{entityName}}): Promise<{{entityName}}> {
    entity.isDeleted = true;
    return this.repo.save(entity);
  }
}
