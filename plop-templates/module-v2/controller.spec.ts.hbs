import { {{serviceClass}} } from '../{{moduleName}}.service';
import { Create{{entityName}}Dto } from '../dto/create-{{entityKebab}}.dto';
import { Query{{entityName}}Dto } from '../dto/query-{{entityKebab}}.dto';
import { Update{{entityName}}Dto } from '../dto/update-{{entityKebab}}.dto';
import { {{entityName}}Controller } from './{{entityKebab}}.controller';

describe('{{entityName}}Controller', () => {
  let service: {
    findAll: jest.Mock;
    findColumnOptions: jest.Mock;
    findOne: jest.Mock;
    create: jest.Mock;
    update: jest.Mock;
    remove: jest.Mock;
  };
  let controller: {{entityName}}Controller;

  beforeEach(() => {
    service = {
      findAll: jest.fn(),
      findColumnOptions: jest.fn(),
      findOne: jest.fn(),
      create: jest.fn(),
      update: jest.fn(),
      remove: jest.fn(),
    };
    controller = new {{entityName}}Controller(service as unknown as {{serviceClass}});
  });

  it('delegates the list query to the facade', async () => {
    const query = {} as Query{{entityName}}Dto;

    await controller.findAll(query);

    expect(service.findAll).toHaveBeenCalledWith(query);
  });

  it('delegates column options with parsed paging', async () => {
    await controller.columnOptions('code', 'ab', '2', '50', '{"status":["ACTIVE"]}');

    expect(service.findColumnOptions).toHaveBeenCalledWith('code', 'ab', 2, 50, '{"status":["ACTIVE"]}');
  });

  it('delegates detail, create, update and remove with the id and DTO', async () => {
    const createDto = {} as Create{{entityName}}Dto;
    const updateDto = {} as Update{{entityName}}Dto;

    await controller.findOne('id-1');
    await controller.create(createDto);
    await controller.update('id-1', updateDto);
    await controller.remove('id-1');

    expect(service.findOne).toHaveBeenCalledWith('id-1');
    expect(service.create).toHaveBeenCalledWith(createDto);
    expect(service.update).toHaveBeenCalledWith('id-1', updateDto);
    expect(service.remove).toHaveBeenCalledWith('id-1');
  });
});
