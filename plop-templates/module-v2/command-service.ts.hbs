import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { {{entityName}} } from '../entities/{{entityKebab}}.entity';
import { Create{{entityName}}Dto } from '../dto/create-{{entityKebab}}.dto';
import { Update{{entityName}}Dto } from '../dto/update-{{entityKebab}}.dto';
import { to{{entityName}}EntityFields } from '../helpers/{{entityKebab}}.mapper';
import { assertValidExtraData, mergeExtraData } from '@/v2/core/base-core/helpers/extra-data.util';

/** Ghi dữ liệu: tạo, cập nhật, xóa mềm. Việc kiểm tra tồn tại do Facade đảm nhiệm. */
@Injectable()
export class {{entityName}}CommandService {
  constructor(
    @InjectRepository({{entityName}})
    private readonly repo: Repository<{{entityName}}>,
  ) {}

  async create(dto: Create{{entityName}}Dto): Promise<{{entityName}}> {
    if (dto.extraData !== undefined) assertValidExtraData(dto.extraData);
    const entity = this.repo.create({
      ...to{{entityName}}EntityFields(dto),
      isDeleted: false,
      extraData: dto.extraData ?? {},
    });
    return this.repo.save(entity);
  }

  async update(entity: {{entityName}}, dto: Update{{entityName}}Dto): Promise<{{entityName}}> {
    if (dto.extraData !== undefined) assertValidExtraData(dto.extraData);
    Object.assign(entity, to{{entityName}}EntityFields(dto));
    if (dto.extraData !== undefined) {
      entity.extraData = mergeExtraData(entity.extraData, dto.extraData);
    }
    return this.repo.save(entity);
  }

  softDelete(entity: {{entityName}}): Promise<{{entityName}}> {
    entity.isDeleted = true;
    return this.repo.save(entity);
  }
}
