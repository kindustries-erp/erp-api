import { NotFoundException } from '@nestjs/common';
import { {{entityName}} } from './entities/{{entityKebab}}.entity';
import { Create{{entityName}}Dto } from './dto/create-{{entityKebab}}.dto';
import { Query{{entityName}}Dto } from './dto/query-{{entityKebab}}.dto';
import { {{entityName}}CommandService } from './services/{{entityKebab}}-command.service';
import { {{entityName}}QueryService } from './services/{{entityKebab}}-query.service';
import { {{serviceClass}} } from './{{moduleName}}.service';

describe('{{serviceClass}}', () => {
  const createdAt = new Date('2026-01-01T00:00:00.000Z');
  const row = { id: 'id-1', isDeleted: false, createdAt, updatedAt: createdAt } as {{entityName}};

  let query: { findAll: jest.Mock; findById: jest.Mock; findColumnOptions: jest.Mock };
  let command: { create: jest.Mock; update: jest.Mock; softDelete: jest.Mock };
  let service: {{serviceClass}};

  beforeEach(() => {
    query = { findAll: jest.fn(), findById: jest.fn(), findColumnOptions: jest.fn() };
    command = { create: jest.fn(), update: jest.fn(), softDelete: jest.fn() };
    service = new {{serviceClass}}(
      query as unknown as {{entityName}}QueryService,
      command as unknown as {{entityName}}CommandService,
    );
  });

  it('wraps a response DTO in the message/data envelope without isDeleted', async () => {
    query.findById.mockResolvedValue(row);

    const result = await service.findOne('id-1');

    expect(result.data.id).toBe('id-1');
    expect(result.message).toEqual(expect.any(String));
    expect(result.data).not.toHaveProperty('isDeleted');
  });

  it('throws NotFound when the row is missing or soft-deleted', async () => {
    query.findById.mockResolvedValue(null);

    await expect(service.findOne('missing')).rejects.toBeInstanceOf(NotFoundException);
  });

  it('maps paginated items to response DTOs with totalPages', async () => {
    query.findAll.mockResolvedValue({ items: [row], total: 41, page: 1, pageSize: 20 });

    const result = await service.findAll({} as Query{{entityName}}Dto);

    expect(result.total).toBe(41);
    expect(result.totalPages).toBe(3);
    expect(result.items[0]).not.toHaveProperty('isDeleted');
  });

  it('passes summaries through with the page', async () => {
    query.findAll.mockResolvedValue({ items: [], total: 0, page: 1, pageSize: 20, summaries: { amount: 9 } });

    const result = await service.findAll({} as Query{{entityName}}Dto);

    expect(result.summaries).toEqual({ amount: 9 });
  });

  it('delegates column options to the query service', async () => {
    query.findColumnOptions.mockResolvedValue({ items: [], total: 0, next: null });

    await service.findColumnOptions('code', undefined, 1, 20, undefined);

    expect(query.findColumnOptions).toHaveBeenCalledWith('code', undefined, 1, 20, undefined);
  });

  it('creates and returns the envelope with a response DTO', async () => {
    command.create.mockResolvedValue(row);

    const result = await service.create({} as Create{{entityName}}Dto);

    expect(result.data.id).toBe('id-1');
    expect(result.message).toEqual(expect.any(String));
  });

  it('soft-deletes an existing row and returns the envelope', async () => {
    query.findById.mockResolvedValue(row);
    command.softDelete.mockResolvedValue({ ...row, isDeleted: true });

    const result = await service.remove('id-1');

    expect(command.softDelete).toHaveBeenCalledWith(row);
    expect(result.data.id).toBe('id-1');
    expect(result.data).not.toHaveProperty('isDeleted');
  });
});
