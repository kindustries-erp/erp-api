import {
  Column,
  CreateDateColumn,
  Entity,
  Index,
  OneToMany,
  PrimaryGeneratedColumn,
  UpdateDateColumn,
} from 'typeorm';
import { {{lineEntityName}} } from './{{lineEntityKebab}}.entity';

@Entity('{{tableName}}')
export class {{headerEntityName}} {
  @PrimaryGeneratedColumn('uuid')
  id: string;

  @Index({ unique: true })
  @Column({ type: 'varchar', length: 100, name: 'receipt_no' })
  receiptNo: string;

  @Index()
  @Column({ type: 'date', name: 'receipt_date' })
