import { BadRequestException, Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { DataSource, Repository } from 'typeorm';
import { {{headerEntityName}} } from '../entities/{{headerEntityKebab}}.entity';
import { {{lineEntityName}} } from '../entities/{{lineEntityKebab}}.entity';
import { Create{{headerEntityName}}Dto } from '../dto/create-{{headerEntityKebab}}.dto';
import { Update{{headerEntityName}}Dto } from '../dto/update-{{headerEntityKebab}}.dto';
import { to{{headerEntityName}}EntityFields } from '../helpers/{{headerEntityKebab}}.mapper';
import { BaseVoucherEngineService } from '@/v2/core/goods-receipts-core/services/base-voucher-engine.service';

@Injectable()
export class {{headerEntityName}}CommandService {
  constructor(
    private readonly dataSource: DataSource,
    @InjectRepository({{headerEntityName}})
    private readonly repo: Repository<{{headerEntityName}}>,
    private readonly voucherEngine: BaseVoucherEngineService,
  ) {}

  async generateDailyReceiptNo(orderDate?: string): Promise<string> {
    return this.voucherEngine.generateDailyVoucherNo(
      this.repo,
      'receiptNo',
      '{{voucherPrefix}}',
      orderDate,
    );
  }

  async create(dto: Create{{headerEntityName}}Dto): Promise<{{headerEntityName}}> {
    return this.dataSource.transaction(async (manager) => {
      const headerRepo = manager.getRepository({{headerEntityName}});
      const lineRepo = manager.getRepository({{lineEntityName}});

      const receiptNo =
        dto.receiptNo?.trim() ||
        (await this.generateDailyReceiptNo(dto.receiptDate));

      const { lines = [], ...headerDto } = dto;
      const entityFields = to{{headerEntityName}}EntityFields({
        ...headerDto,
        receiptNo,
        status: headerDto.status || 'DRAFT',
        paymentStatus: headerDto.paymentStatus || 'UNPAID',
      });

      const lineEntities: {{lineEntityName}}[] = [];
      let lineNo = 1;
      for (const l of lines) {
        const qty = Number(l.qtyReceived || 0);
        const cost = Number(l.unitCost || 0);
        const amount = l.amount !== undefined ? Number(l.amount) : qty * cost;

        const line = lineRepo.create({
          lineNo: lineNo++,
          itemCode: l.itemCode ?? undefined,
          itemName: l.itemName,
          unit: l.unit || 'Cái',
          qtyReceived: String(qty),
          unitCost: String(cost),
          amount: String(amount),
          notes: l.notes ?? undefined,
        });
        lineEntities.push(line);
      }

      const calculatedTotal = this.voucherEngine.sumLineAmounts(lineEntities);

      if (dto.totalAmount !== undefined && dto.totalAmount !== null) {
        entityFields.totalAmount = String(dto.totalAmount);
      } else if (lineEntities.length > 0) {
        entityFields.totalAmount = String(calculatedTotal);
      }

      const receipt = headerRepo.create({
        ...entityFields,
        isDeleted: false,
      });
      const savedReceipt = await headerRepo.save(receipt);

      for (const line of lineEntities) {
        line.{{headerEntityCamel}}Id = savedReceipt.id;
        await lineRepo.save(line);
      }

      savedReceipt.lines = lineEntities;
      return savedReceipt;
    });
  }

  async update(
    entity: {{headerEntityName}},
    dto: Update{{headerEntityName}}Dto,
  ): Promise<{{headerEntityName}}> {
    this.voucherEngine.validateVoucherTransition(entity.status, 'update');

    return this.dataSource.transaction(async (manager) => {
      const headerRepo = manager.getRepository({{headerEntityName}});
      const lineRepo = manager.getRepository({{lineEntityName}});

      const { lines, ...headerDto } = dto;
      const entityFields = to{{headerEntityName}}EntityFields(headerDto);
      Object.assign(entity, entityFields);

      if (lines !== undefined) {
        await lineRepo.delete({ {{headerEntityCamel}}Id: entity.id });

        const lineEntities: {{lineEntityName}}[] = [];
        let lineNo = 1;

        for (const l of lines) {
          const qty = Number(l.qtyReceived || 0);
          const cost = Number(l.unitCost || 0);
          const amount = l.amount !== undefined ? Number(l.amount) : qty * cost;

          const line = lineRepo.create({
            {{headerEntityCamel}}Id: entity.id,
            lineNo: lineNo++,
            itemCode: l.itemCode ?? undefined,
            itemName: l.itemName,
            unit: l.unit || 'Cái',
            qtyReceived: String(qty),
            unitCost: String(cost),
            amount: String(amount),
            notes: l.notes ?? undefined,
          });
          lineEntities.push(await lineRepo.save(line));
        }

        if (dto.totalAmount === undefined) {
          entity.totalAmount = String(
            this.voucherEngine.sumLineAmounts(lineEntities),
          );
        }
        entity.lines = lineEntities;
      }

      return headerRepo.save(entity);
    });
  }

  async post(entity: {{headerEntityName}}): Promise<{{headerEntityName}}> {
    this.voucherEngine.validateVoucherTransition(entity.status, 'post');

    return this.dataSource.transaction(async (manager) => {
      const headerRepo = manager.getRepository({{headerEntityName}});
      const lineRepo = manager.getRepository({{lineEntityName}});

      const lines =
        entity.lines ||
        (await lineRepo.find({
          where: { {{headerEntityCamel}}Id: entity.id },
          order: { lineNo: 'ASC' },
        }));

      if (lines.length === 0) {
        throw new BadRequestException('Chứng từ chưa có dòng hàng nào');
      }

      // Hook xử lý nghiệp vụ khi ghi sổ (vd: tăng tồn kho, sinh sổ nhật ký)
      entity.status = 'POSTED';
      entity.lines = lines;
      return headerRepo.save(entity);
    });
  }

  async cancel(entity: {{headerEntityName}}): Promise<{{headerEntityName}}> {
    this.voucherEngine.validateVoucherTransition(entity.status, 'cancel');

    return this.dataSource.transaction(async (manager) => {
      const headerRepo = manager.getRepository({{headerEntityName}});

      // Hook xử lý hoàn hoàn trả nghiệp vụ khi hủy (vd: giảm tồn kho hoàn trả)
      entity.status = 'CANCELLED';
      return headerRepo.save(entity);
    });
  }

  async softDelete(entity: {{headerEntityName}}): Promise<{{headerEntityName}}> {
    this.voucherEngine.validateVoucherTransition(entity.status, 'delete');
    entity.isDeleted = true;
    return this.repo.save(entity);
  }
}

