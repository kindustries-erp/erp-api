# App Configuration
PORT=10000
NODE_ENV=development

# Directus Configuration
DIRECTUS_URL=https://db-production.liouni.com
DIRECTUS_ADMIN_TOKEN=your_static_admin_token_here

# JWT Impersonation (dùng cho API POST /auth/impersonate)
# Đặt một chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_IMPERSONATION_SECRET=change_this_to_a_random_secret_at_least_32_chars
