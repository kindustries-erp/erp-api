# App Configuration
PORT=10000
NODE_ENV=development

# Neon / Postgres Configuration
# Preferred: use ERP_MASTER_DATABASE_URL from Neon
ERP_MASTER_DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DB_SSL=true

# Optional split config if not using ERP_MASTER_DATABASE_URL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_DATABASE=erp_core

# Local auth
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password
