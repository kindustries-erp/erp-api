# App Configuration
PORT=10000
NODE_ENV=development

# Neon / Postgres Configuration
# Preferred: use DATABASE_URL from Neon
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DB_SSL=true

# Optional split config if not using DATABASE_URL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_DATABASE=erp_core

# Local auth
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password

# Email Ingest (IMAP/Gmail)
EMAIL_PROVIDER=IMAP
EMAIL_IMAP_AUTH_MODE=PASSWORD
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_IMAP_USER=your-mailbox@gmail.com
EMAIL_IMAP_PASS=your-app-password
EMAIL_IMAP_ACCESS_TOKEN=
EMAIL_IMAP_REFRESH_TOKEN=
EMAIL_IMAP_CLIENT_ID=
EMAIL_IMAP_CLIENT_SECRET=
EMAIL_IMAP_TOKEN_URL=https://oauth2.googleapis.com/token
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_SYNC_LIMIT=25
